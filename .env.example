# Copy to .env and fill in. .env is git-ignored.

# Only needed when running the API or Alembic on the host instead of in Docker.
DATABASE_URL=postgresql+psycopg://rqlens:rqlens@localhost:5432/rqlens
REDIS_URL=redis://localhost:6379/0
DATA_DIR=data

# LLM provider (Phase 0, LLMClient)
LLM_API_KEY=

# Auth.js (Phase 0, login)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
