# Production settings for docker-compose.prod.yml. Copy to .env.prod and fill in:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# .env.prod is git-ignored. Generate secrets with: openssl rand -base64 32

# Required
PUBLIC_URL=https://rq-lens.example.org
POSTGRES_PASSWORD=
API_JWT_SECRET=
AUTH_SECRET=

# Sign-in: set at least one provider. Callback URL: <PUBLIC_URL>/api/auth/callback/<google|github>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Host port for the web app (put a TLS reverse proxy such as Caddy or nginx in front).
WEB_PORT=3000

# AI provider: any OpenAI-compatible endpoint. Without a key, profiling, SQL, rule-based RQ
# verdicts and template insights still work; chat and RQ parsing need it.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.7-flash
# LLM_EMBEDDING_MODEL=gemini-embedding-001
# USD per 1M tokens, for cost tracking and the budget: {"model": [input, output]}
# LLM_PRICES={"gpt-4o-mini": [0.15, 0.6]}

# Per-user limits (0 = no limit)
# MAX_PROJECTS_PER_USER=20
# MAX_DATASETS_PER_PROJECT=50
# MAX_UPLOAD_BYTES=524288000
# MONTHLY_LLM_BUDGET_USD=5
# MONTHLY_LLM_CALLS=2000

# Error tracking (optional)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# OCR for scanned papers (on by default in the production image)
# OCR_ENABLED=true
# MAX_OCR_PAGES=60
